{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Zoom OAuth Sample App",
  "theme": "luma",
  "colors": {
    "primary": "#0C5CFF",
    "light": "#8AB4FF",
    "dark": "#0C5CFF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/zoom-light.svg",
    "dark": "/logo/zoom-dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "light"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "fonts": {
    "heading": {
      "family": "Happy Display",
      "source": "/fonts/happy-display-600.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Almaden Sans",
      "source": "/fonts/almaden-sans-400.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/zoom/zoom-oauth-sample-app"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zoom/zoom-oauth-sample-app"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "Setup & Configuration",
        "pages": [
          "setup/local-setup",
          "setup/ngrok",
          "setup/zoom-marketplace-app"
        ]
      },
      {
        "group": "How It Works",
        "pages": [
          "how-it-works/oauth-flow",
          "how-it-works/environment-variables",
          "how-it-works/api-call"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/configuration",
          "reference/zoom-api-endpoints",
          "reference/troubleshooting"
        ]
      }
    ]
  }
}
